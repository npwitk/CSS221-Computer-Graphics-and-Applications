Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"circleDot", "[", "t_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"RCir", "*", 
      RowBox[{"Cos", "[", "t", "]"}]}], ",", 
     RowBox[{"RCir", "*", 
      RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9568224829196033`*^9, 3.9568224857151737`*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"1abfd856-b489-4425-ad85-591526222820"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"spiral", "[", "t_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"5", "*", "t"}], "]"}]}], ",", "0", ",", 
     RowBox[{"t", "*", 
      RowBox[{"Cos", "[", 
       RowBox[{"5", "*", "t"}], "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.956822486685658*^9, 3.9568224927736387`*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"b04ca8d0-52df-45ca-bfd6-91ee51c11126"],

Cell[BoxData[
 RowBox[{
  RowBox[{"circleGeo", "=", 
   RowBox[{
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{"circleDot", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Dotted"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.956822493560771*^9, 3.9568224992211*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"b3f4657b-a489-42df-b497-d73675ac621f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spiralGeo", "=", 
   RowBox[{
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{"spiral", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "*", "Pi"}]}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9568224998139477`*^9, 3.956822502487447*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"cf7aa86c-f0ce-46d4-915f-8b3661cea3e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"placedCircle", "=", 
   RowBox[{"GeometricTransformation", "[", 
    RowBox[{"circleGeo", ",", 
     RowBox[{"TranslationTransform", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"3", "*", "Pi"}], ",", "0", ",", "0"}], "}"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
