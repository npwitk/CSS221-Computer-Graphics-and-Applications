Cell[BoxData[
 RowBox[{
  RowBox[{"placedSpiral", "=", 
   RowBox[{"GeometricTransformation", "[", 
    RowBox[{"spiralGeo", ",", 
     RowBox[{"TranslationTransform", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"-", "3"}], "*", "Pi"}], ",", "0"}], "}"}], "]"}]}], "]"}]}],
   ";"}]], "Input",
