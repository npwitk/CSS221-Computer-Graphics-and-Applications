 RowBox[{
  RowBox[{
   RowBox[{"v3", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "#1", "]"}], ",", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", "*", "#2"}], "]"}], ",", 
      RowBox[{"Sin", "[", "#3", "]"}]}], "}"}], "&"}]}], ";"}]], "Input",
