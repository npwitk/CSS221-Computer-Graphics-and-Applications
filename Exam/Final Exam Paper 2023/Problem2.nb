Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TF4", "[", "a_", "]"}], ":=", 
   RowBox[{"Composition", "[", 
    RowBox[{
     RowBox[{"TranslationTransform", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "4"}], "}"}], "]"}], ",", 
     RowBox[{"RotationTransform", "[", 
      RowBox[{"a", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "6"}], "}"}]}], "]"}], ",", 
     RowBox[{"TranslationTransform", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", "0", ",", "0"}], "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"M4", "[", "a_", "]"}], ":=", 
  RowBox[{"Evaluate", "[", 
   RowBox[{"TransformationMatrix", "[", 
    RowBox[{"TF4", "[", "a", "]"}], "]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"TransCir4", "[", 
   RowBox[{"a_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"M4", "[", "a", "]"}], ".", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sin", "[", "t", "]"}], ",", 
       RowBox[{"Cos", "[", "t", "]"}], ",", "1", ",", "1"}], "}"}]}], ")"}], "[", 
   RowBox[{"[", 
    RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"GG4", "[", "a_", "]"}], ":=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"TransCir4", "[", 
     RowBox[{"a", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Thickness", "[", "0.02", "]"}], "}"}]}], ",", 
    RowBox[{"Axes", "->", "True"}], ",", 
    RowBox[{"AxesOrigin", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", "6"}]}], "]"}]}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Show", "[", 
    RowBox[{"GG4", "[", "a", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", 
     RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], "Input",
